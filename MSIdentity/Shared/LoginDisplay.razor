@using ThirdPartySignOn.MSIdentity.Data
@using System.Security.Claims
@using Microsoft.Extensions.DependencyInjection
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AuthenticateStub AuthenticateStub
@inherits OwningComponentBase
<AuthorizeView>
    <Authorized>
        Hello, @userName! <a href="@logoutUrl">Logout</a>
    </Authorized>
    <NotAuthorized>
        You're not authorized! <a href="@navigateUrl">Login</a>
        <button class="btn-primary" @onclick="@(async () => await LoginClick())">LoginClick</button>
    </NotAuthorized>
</AuthorizeView>
@code {
    public AuthenticateStub? AuthenticationStub { get; set; }
    public string returnUrl = "", navigateUrl = "", logoutUrl = "logout";
    public string userName = "", realName = "", userCrypt = "";

    protected override async Task OnInitializedAsync()
    {

        AuthenticationStub = ScopedServices.GetRequiredService<AuthenticateStub>();
        Dictionary<string, string> dictNames = await AuthenticateStub.GetLoginIds(AuthenticationStateProvider);
        if (dictNames != null && dictNames.Count > 0)
        {
            if (dictNames.ContainsKey("preferred_username"))
                userName = dictNames["preferred_username"];
                
            if (string.IsNullOrEmpty(userName) && dictNames.ContainsKey("User.Identity.Name"))
                userName = dictNames["User.Identity.Name"];
            
            if (dictNames.ContainsKey("name"))
                realName = dictNames["name"];
        }      

        logoutUrl = (string.IsNullOrEmpty(userName)) ? "Logout" : $"Logout?user={userName}";
        MSIdentityLog.LogStatic("UserName initialized: " + userName + " realName: " + realName);

        userCrypt = userName.EnCrypt();
        MSIdentityLog.LogStatic("UserName encrypted: " + userCrypt);

        Uri uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        string rawUrl = uri.ToString();
       
        // var authResult = await Microsoft.AspNetCore.Mvc..PageModel.HttpContext.AuthenticateAsync();
        returnUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        navigateUrl = "login?redirectUri=" + returnUrl;
        
    }

    async Task LoginClick()
    {
        await Task.Yield(); // Ensure this runs asynchronously to avoid blocking the UI thread
        NavigationManager.NavigateTo($"login?redirectUri={returnUrl}", forceLoad: true);
    }

}


