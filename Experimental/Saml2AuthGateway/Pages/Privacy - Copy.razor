@code {
    private string returnUrl = "";
    public AuthenticateStub? Authentication { get; set; }

    /// <summary>
    /// OnInitialized is always called im early blazor component lifecycle, before the component is rendered.
    /// </summary>
    override protected void OnInitialized()
    {
        returnUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);        
    }
    
    private void GoBack()
    {
        returnUrl = NavigationManager.ToBaseRelativePath(NavigationManager.BaseUri);
        NavigationManager.NavigateTo(returnUrl, forceLoad: true);
    }
    
}
