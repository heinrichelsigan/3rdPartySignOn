@namespace ThirdPartySignOn.MSIdentity.Shared
<AuthorizeView>
    <Authorized>
        Hello, @context.User.Identity?.Name!
        <a href="ThirdPartySignOn.MSIdentity/Account/SignOut">Log out</a>
    </Authorized>
    <NotAuthorized>
        <a href="ThirdPartySignOn.MSIdentity/Account/SignIn">Log in</a>
    </NotAuthorized>
</AuthorizeView>
