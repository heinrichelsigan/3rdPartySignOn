@using System.Security.Claims
@using SamlAuthGateway.Data
@using SamlAuthGateway.Services
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AuthStub AuthenticateStub
@inject SettingsKeyReader SettingsKeys
@inject IHttpContextAccessor Http
@inject IJSRuntime JS
@inject ICookie cookie
@inherits OwningComponentBase
@page "/auto"

<PageTitle>Auto</PageTitle>

<h1>Auto</h1>

<p role="alertdialog" style="visibility: @visibility; padding: 2px; margin: 2px; border-block: dashed;">
    UserName; <label>@userName</label>
    <br />
    NavigateUrl: <a href="@navigateUrl" target="_self">@navigateUrl</a>
    <br />  
</p>

@code {
    public AuthStub? Authentication { get; set; }
    public string navigateUrl = "", rawUrl = "", userName = "";
    public string visibility = "visible";
    public bool redirect = true;
    public Exception? exception;


    /// <summary>
    /// OnInitializedAsync is always called im early blazor component lifecycle, before the component is rendered.
    /// It is used to perform any asynchronous initialization tasks that are required for the component to function properly. 
    /// This method is called after the component has been instantiated and its parameters have been set, 
    /// but before the component is rendered for the first time.
    /// 
    /// Redirects to slotmachine with the SAML2 username in the query string
    /// 
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        userName = await GetUserLoginNameAsync();
        navigateUrl = await GetNavUrl(userName);
    }

    protected async Task<string> GetNavUrl(string loginName)
    {
        if (string.IsNullOrEmpty(loginName))
            loginName = await GetUserLoginNameAsync();

        string navUrl = string.Concat(SettingsKeys.RedirectUrl, "?user=", loginName);
        string urlSuffix = "";
        rawUrl = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).ToString();
        if (rawUrl.IndexOf("?") > -1)
        {
            urlSuffix = rawUrl.Substring(rawUrl.IndexOf("?") + 1);
            navUrl += "&" + urlSuffix;
        }
        SamlLog.LogStatic("navigateUrl = " + navUrl);
        return navUrl;
    } 

    protected async Task<string> GetUserLoginNameAsync()
    {
        if (string.IsNullOrEmpty(userName))
        {
            // gets the user name identifier from the authentication state provider
            AuthenticateStub = ScopedServices.GetRequiredService<AuthStub>();
            var usr = await AuthenticateStub.GetSamlUserInfo_Async(AuthenticationStateProvider);
            userName = usr.LoginName;
            SamlLog.LogStatic("UserName  " + userName + " authenticated");             
        }
        return userName;
    }


    protected async Task RegisterAndRedirectSaml2Net48()
    {
        redirect = true;
        userName = await GetUserLoginNameAsync();
        navigateUrl = await GetNavUrl(userName);
        if (redirect)
        {
            SamlLog.LogStatic("Navigating to: " + navigateUrl);
            NavigationManager.NavigateTo(navigateUrl, forceLoad: true);
        }
    }



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RegisterAndRedirectSaml2Net48();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    
}