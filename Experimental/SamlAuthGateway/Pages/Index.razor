@using System.Security.Claims
@using SamlAuthGateway.Data
@using SamlAuthGateway.Services
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@using System.Reflection
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AuthStub AuthenticateStub
@inject SettingsKeyReader SettingsKeys
@inherits OwningComponentBase
@page "/"

<PageTitle>SamlAuthGateway</PageTitle>

<h1>SamlAuthGateway</h1>

Welcome to SamlAuthGateway,
<br />
click on <NavLink class="nav-fill" href="Index">Index</NavLink> to get that page.
<br />
click on <NavLink class="nav-fill" href="Claims">Claims</NavLink> to view your saml2 claims.
<br />
click on <NavLink class="nav-item" href="Privacy?Hallo=Gallo&mw=guy">Privacy</NavLink> to read privacy agreement.
<br />
click on <NavLink class="nav-pills" href="Auto">Auto</NavLink> redirect.

<br />

<p role="alertdialog" style="visibility: @visibility_value; display: @display_value; padding: 2px; margin: 2px; border-block: dashed; width: 80%">
    About @AssemblyTitle
    <br />
    Version @AssemblyVersion
    <br />
    &copy; @AssemblyCopyright
    <br />
    @AssemblyDescription    
    <br />
    UserName: <label>@userName</label>
    <br />
    NavigateUrl: <a href="@navigateUrl" target="_self">@navigateUrl</a>
</p>
<br />

@code {
    public AuthStub? AuthStub { get; set; }
    public string returnUrl = "", navigateUrl = "", rawUrl = "", userName = "";
    public string visibility_value = "hidden", display_value = "none";
    public SamlUserInfo samlUsr = new SamlUserInfo();

    /// <summary>
    /// OnInitializedAsync is always called im early blazor component lifecycle, before the component is rendered.
    /// It is used to perform any asynchronous initialization tasks that are required for the component to function properly.
    /// This method is called after the component has been instantiated and its parameters have been set,
    /// but before the component is rendered for the first time.
    ///
    /// rawUrl is the absolute url of the current page, including the query string.
    /// AuthStub is used to get the login name identifier and the saml2 claims from the authentication state provider, which is injected into the component.
    /// 
    /// </summary>
    /// <returns>blank <see cref="Task"/></returns>
    protected override async Task OnInitializedAsync()
    {
        AuthenticateStub = ScopedServices.GetRequiredService<AuthStub>();

        Uri uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        rawUrl = uri.ToString();
        returnUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        navigateUrl = SettingsKeys.RedirectUrl;

        samlUsr = await AuthenticateStub.GetSamlUserInfo_Async(AuthenticationStateProvider);
        userName = samlUsr.LoginName;

        // Alternativly you can call it:
        // if (string.IsNullOrEmpty(formsAuthTicket))
        //         formsAuthTicket = await Saml2SoapClient.GetFormsTicketHttpAsync(userName, false);

        visibility_value = "visible";
        display_value = "block";                  
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {        
        if (firstRender && string.IsNullOrEmpty(userName))
        {
            samlUsr = await AuthenticateStub.GetSamlUserInfo_Async(AuthenticationStateProvider);
            userName = samlUsr.LoginName;
            visibility_value = "visible";
            display_value = "block";
        }

        await base.OnAfterRenderAsync(firstRender);
    }



    #region Assembly Attribute Accessors

    public string AssemblyTitle
    {
        get
        {
            object[] attributes = Assembly.GetExecutingAssembly().GetCustomAttributes(typeof(AssemblyTitleAttribute), false);
            string assTitle = System.IO.Path.GetFileNameWithoutExtension(System.Reflection.Assembly.GetAssembly(typeof(Index))?.Location);
            if (attributes.Length > 0 && !string.IsNullOrEmpty(((AssemblyTitleAttribute)attributes[0]).Title))
            {
                assTitle = ((AssemblyTitleAttribute)attributes[0]).Title;
            }               
            return assTitle ?? "";
        }
    }

    public string AssemblyVersion { get => Assembly.GetExecutingAssembly().GetName().Version?.ToString() ?? "0.0.0"; }

    public string AssemblyDescription
    {
        get
        {
            object[] attributes = Assembly.GetExecutingAssembly().GetCustomAttributes(typeof(AssemblyDescriptionAttribute), false);
            return (attributes.Length == 0) ? "" : ((AssemblyDescriptionAttribute)attributes[0]).Description;
        }
    }

    public string AssemblyCopyright
    {
        get
        {
            object[] attributes = Assembly.GetExecutingAssembly().GetCustomAttributes(typeof(AssemblyCopyrightAttribute), false);
            return (attributes.Length == 0) ? "" : ((AssemblyCopyrightAttribute)attributes[0]).Copyright;
        }
    }

    #endregion

}
