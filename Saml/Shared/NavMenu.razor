@using System.Security.Claims
@using ThirdPartySignOn.Saml.Services
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AuthenticateStub AuthenticateStub
@inherits OwningComponentBase
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">SSO.Saml</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div style="color: ghostwhite">
            &#x1f3e0;&nbsp;<a style="color: ghostwhite; font-style: unset;" href="">Home</a>
            <br />
            &#129513;&nbsp;<a style="color: ghostwhite;" href="UserClaims">Claims</a>
            <br />
            &#128218;&nbsp;<a style="color: ghostwhite;" href="Files">Files</a>
            <br />
            &#129389;&nbsp;<a style="color: ghostwhite;" href="Fruits">Fruits</a>
            <br />
            &#128220;&nbsp;<a style="color: ghostwhite;" href="Privacy">Privacy</a>
            <br />
            &#x1f48a;&nbsp;<a style="color: ghostwhite;" href="TestParam">TestParam</a>
            <br />
            &#9999;&nbsp;<a style="color: ghostwhite;" href="@LogoutUrl">Logout</a>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    public string LogoutUrl = "Logout";
    public AuthenticateStub? Authentication { get; set; }

    protected override async Task OnInitializedAsync()
    {
        string userName = "";
        AuthenticateStub = ScopedServices.GetRequiredService<AuthenticateStub>();
        if (ClaimsPrincipal.Current?.Identity?.IsAuthenticated ?? false)
            userName = ClaimsPrincipal.Current?.Identity?.Name ?? string.Empty;
        if (string.IsNullOrEmpty(userName))
            userName = await AuthenticateStub.GetLoginNameIdentifier(AuthenticationStateProvider);        
        if (!string.IsNullOrWhiteSpace(userName))
            LogoutUrl += $"?usercrypt={userName.EnCrypt()}";
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
