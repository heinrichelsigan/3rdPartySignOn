@using Saml2AuthGateway.Data
@using Saml2AuthGateway.Services
@using Microsoft.Extensions.DependencyInjection
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inherits OwningComponentBase
<AuthorizeView>
    <Authorized>
        Hello, @username! <a href="Logout?user=@username">Logout</a>
    </Authorized>
    <NotAuthorized>
        You're not authorized! <a href="@navigateUrl">Login</a>
        <button class="btn-primary" @onclick="@(async () => await LoginClick())">LoginClick</button>
    </NotAuthorized>
</AuthorizeView>
@code {
    public AuthenticateStub? AuthenticateStub { get; set; }
    public string returnUrl = "", navigateUrl = "";
    public string username = "";

    protected override async Task OnInitializedAsync()
    {       
        AuthenticateStub = ScopedServices.GetRequiredService<AuthenticateStub>();
        username = await AuthenticateStub.GetLoginNameIdentifier(AuthenticationStateProvider);
        EnablerLog.LogStatic("UserName initialized: " + username);
        Uri uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        string rawUrl = uri.ToString();
       
        // var authResult = await Microsoft.AspNetCore.Mvc..PageModel.HttpContext.AuthenticateAsync();
        returnUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        navigateUrl = "login?redirectUri=" + returnUrl;
        
    }

    async Task LoginClick()
    {
        NavigationManager.NavigateTo($"login?redirectUri={returnUrl}", forceLoad: true);
    }

}


