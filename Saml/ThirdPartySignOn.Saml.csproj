<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Copyright>2000 - 2060 Heinrich Elsigan for Logic4Biz GmbH</Copyright>
    <PackageProjectUrl>https://test.enabler.info/3rdPartySignOn/Saml2/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/heinrichelsigan/3rdPartySignOn</RepositoryUrl>
    <AssemblyVersion>2.26.616</AssemblyVersion>
    <FileVersion>2.26.616</FileVersion>
    <StartupObject>ThirdPartySignOn.Saml.Program</StartupObject>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>3rdPartySignOn Saml2</PackageReleaseNotes>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
    <WarningLevel>9999</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
    <WarningLevel>9999</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Connected Services\**" />
    <Content Remove="Connected Services\**" />
    <EmbeddedResource Remove="Connected Services\**" />
    <None Remove="Connected Services\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Data\SamlClaimReduced.cs" />
    <Compile Remove="Pages\SignInOut.cshtml.cs" />
    <Compile Remove="Services\CookieStorageAccessor.cs" />
    <Compile Remove="Services\HttpClientRequest.cs" />
    <Compile Remove="Services\SettingsKeyReader.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="Pages\Logout.razor" />
    <Content Remove="Pages\LogoutSaml2Net48.razor" />
    <Content Remove="Pages\SignInOut.cshtml" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="log\README.MD" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="log\README.MD">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.83.3" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.9.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.18.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens.Saml" Version="8.18.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Sustainsys.Saml2" Version="2.11.0" />
    <PackageReference Include="Sustainsys.Saml2.AspNetCore2" Version="2.11.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.7" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Duplex" Version="6.0.0" />
    <PackageReference Include="System.ServiceModel.Http" Version="10.0.652802" />
    <PackageReference Include="System.ServiceModel.NetTcp" Version="10.0.652802" />
    <PackageReference Include="System.ServiceModel.Security" Version="6.0.0" />
    <PackageReference Include="System.ServiceModel.Federation" Version="10.0.652802" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SSO3rd.Library\SSO3rd.Library.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="wwwroot\files\" />
  </ItemGroup>
</Project>