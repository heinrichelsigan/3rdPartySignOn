<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-MSIdentity-437a817b-864a-4a76-9075-4e85b2e8ca61</UserSecretsId>
    <WebProject_DirectoryAccessLevelKey>0</WebProject_DirectoryAccessLevelKey>
    <StartupObject>ThirdPartySignOn.MSIdentity.Program</StartupObject>
    <RepositoryUrl>https://github.com/heinrichelsigan/3rdPartySignOn/</RepositoryUrl>
    <AssemblyVersion>2.25.506</AssemblyVersion>
    <FileVersion>2.25.506</FileVersion>
    <PackageProjectUrl>https://test.cqrxs.eu/SingleSignOn/Saml</PackageProjectUrl>
    <Description>https://test.cqrxs.eu/SingleSignOn/Saml
https://test.area23.at/ThirdPartySignOn/MSIdentity/</Description>
    <Copyright>Heinrich Elsigan 2000 - 2040</Copyright>
    <Title>SSO.MSIdentity</Title>
    <PackageIcon>favicon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Log\README.MD" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Log\README.MD" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="wwwroot\favicon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" NoWarn="NU1605" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.7" NoWarn="NU1605" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.9.0" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="4.9.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
