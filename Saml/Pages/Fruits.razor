@using ThirdPartySignOn.Saml.Data
@using ThirdPartySignOn.Saml.Services
@using Microsoft.Extensions.DependencyInjection
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inherits OwningComponentBase
@page "/Fruits"

<PageTitle>Fruits</PageTitle>

<h1><button class="btn btn-link" @onclick="@(async () => await FruitSlotMachineStart())">Fruits</button></h1>
<table border="0" width="660px" height="360px" cellpadding="0" cellspacing="0">
	<tr>
		<td colspan="5" width="660px"><label style='font-size: medium' id="h2Run">@h2Run</label></td>
	</tr>
	<tr height="360px">
		<td width="120px">
			<img id="fruitSlot0" src="@fruit0" width="120px" border="0" />
		</td>
		<td width="120px">
			<img id="fruitSlot1" src="@fruit1" width="120px" border="0" />
		</td>
		<td width="120px">
			<img id="fruitSlot2" src="@fruit2" width="120px" border="0" />
		</td>
		<td width="120px">
			<img id="fruitSlot3" src="@fruit3" width="120px" border="0" />
		</td>
		<td width="180px">
			<img id="machineTurn" src="@machine" width="180px" border="0" 
				 @onclick="@(async () => await FruitSlotMachineStart())" />
		</td>
	</tr>
</table>

@code {
	private string returnUrl = "", h2Run = " ", fruit0 = "", fruit1 = "", fruit2 = "", fruit3 = "", machine = "";
	public AuthenticateStub? Authentication { get; set; }
	int machineRunning = 0, machineStarted = 0;
	Random random = new Random(DateTime.UtcNow.Millisecond);

	protected override void OnInitialized()
	{
		machine = "machineReady.gif";
		fruit0 = "cherry.gif";
		fruit1 = "apple.gif";
		fruit2 = "orange.gif";
		fruit3 = "apple.gif";
		random = new Random(DateTime.UtcNow.Millisecond);

		returnUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
		base.OnInitialized();
	}

	private void Assert(int num)
	{
		SamlLog.LogOriginMsg("Fruits.razor", "illegal num: " + num);
	}

	protected string GetFruitByNumber(int slotNumber)
	{
		var fruit = "";
		int fruitNum = (random.Next(10) % 3) + 1;
		int slotSpeed = (slotNumber < 3) ? slotNumber : random.Next(slotNumber, slotNumber + 1);
		switch (fruitNum)
		{
			case 1: fruit = "apple" + slotSpeed + ".gif"; break;
			case 2: fruit = "orange" + slotSpeed + ".gif"; break;
			case 3: fruit = "cherry" + slotSpeed + ".gif"; break;
			default: Assert(fruitNum); break;
		}
		return fruit;
	}

	protected async Task FruitSlotMachineStart()
	{
		string fruitSlotId = "fruitSlot";
		string fruitImage = "apple0.gif";
		random = new Random(DateTime.UtcNow.Millisecond);

		if (machineRunning == 1)
		{
			try
			{
				await SetMachineWithDelay("machineReady.gif", 1400);
				await SetTextH2(0, "machine breaking", 21000);
			}
			catch (Exception ex)
			{
			}
			return;
		}

		if (machineRunning == 0)
		{
			machine = "machineStart.gif";
			machineStarted++;
			machineRunning = 1;
			await SetTextH2WithSound(1, "machine running", "coin.wav");
			try
			{
				;
			}
			catch (Exception mRunExc)
			{
				SamlLog.LogOriginMsgEx("Fruits.razor", "FruitSlotMachineStart() machineRunning = 0", mRunExc);
			}

			int ac = 0, cc = 0, oc = 0, slcnt = 0;
			while (slcnt < 4)
			{
				fruitSlotId = "fruitSlot" + slcnt;
				try
				{
					switch (slcnt)
					{
						case 0:
							fruit0 = GetFruitByNumber(slcnt);
							fruitImage = fruit0; break;
						case 1:
							fruit1 = GetFruitByNumber(slcnt);
							fruitImage = fruit1; break;
						case 2:
							fruit2  = GetFruitByNumber(slcnt);
							fruitImage = fruit2; break;
						case 3:
							fruitImage = GetFruitByNumber(slcnt); 
							fruit3 = fruitImage; break;
						default:
							Assert(slcnt); break;
					}

					if (fruitImage.IndexOf("apple") > -1) ac++;
					if (fruitImage.IndexOf("cherry") > -1) cc++;
					if (fruitImage.IndexOf("orange") > -1) oc++;
				}
				catch (Exception fruitSlotIterateEx)
				{
					SamlLog.LogOriginMsgEx("Fruits.razor", "fruitSlotMachineStart() iterate " + fruitSlotId + " " + fruitImage + " throwed exception: \n\r", fruitSlotIterateEx);
				}
				slcnt++;
			}

			await SetMachineWithDelay("machineReady.gif", 1400);

			if (ac == 4 || oc == 4 || cc == 4)
			{
				string winMsg = (ac == 4) ? "4x APPLE - YOU WIN!" :
					((cc == 4) ? "4x CHERRY - YOU'RE SWEET!" : "4x ORANGE - THOU TRUMPS!");
				await SetTextH2WithSound(0, winMsg, "four4.wav", 24000);
			}
			else if ((ac == 2 && oc == 2) || (ac == 2 && cc == 2) || (cc == 2 && oc == 2))
				await SetTextH2WithSound(0, "2x pairs", "two2.mp3", 25000);
			else
				await SetTextH2WithSound(0, "No luck, try again fruit slot machine", "three3.mp3", 25000);
		}
	}

	protected async Task SetMachineWithDelay(string machineGif, int delayMs)
	{
		await Task.Run(() => { Thread.Sleep(delayMs); machine = machineGif; });
	}

	protected async Task SetTextH2(int mstate, string htext, int delay = 10)
	{
		await Task.Run(() => { Thread.Sleep(delay); machineRunning = mstate; h2Run = htext; });
	}

	protected async Task SetTextH2WithSound(int mstate, string htext, string soundName, int delay = 10)
	{		
		try
		{
			await JS.InvokeVoidAsync("eval",
				"setTimeout(function() { " +
				"   document.getElementById('h2Run').innerText = '" + htext + "'; " +
				"   let sound = new Audio('" + soundName + "'); " + @"
                        sound.autoplay = true;
                        sound.loop = false;
                        try {
                            sound.play();
                        } catch (soundPlayEx) {
                           console.log('playSound(" + soundName + ") throwed exception: ' + soundPlayEx); " + @"
			            }
                        setTimeout(function() {
                            sound.loop = false;
                            sound.pause();
                            sound.autoplay = false;
                            sound.currentTime = 0;
                            try {
                                sound.src = """";
                                sound = null;
                            } catch (exSnd) {
                            }
                            soundDuration = 2500;
                        }, 2500);" +
				"}, " + delay + "); "
			);
		}
		catch (Exception ex)
		{
			SamlLog.LogOriginMsgEx("ICookie.cs", "playSound(" + soundName + ")", ex);
		}
	
		await Task.Run(() =>
		{ 
			// Thread.Sleep(delay);
			machineRunning = mstate; 
			h2Run = htext; 
			 			
		});
	}

	

    private void GoBack()
    {
        returnUrl = NavigationManager.ToBaseRelativePath(NavigationManager.BaseUri);
        NavigationManager.NavigateTo(returnUrl, forceLoad: true);
    }
    
}
